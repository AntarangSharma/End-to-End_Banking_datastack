# Copy to .env and fill in before running `docker compose up -d`.
# Every variable below is read by docker-compose.yml or by a script in this repo.
# Do not commit the resulting .env file.

# ---------------------------------------------------------------
# Banking Postgres (CDC source) - used by docker-compose.yml,
# data-generator/fake_generator.py, kafka-debezium/generate_and_post_connector.py
# ---------------------------------------------------------------
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=banking_pass
POSTGRES_DB=banking_db

# Host/port the Python scripts use to reach Postgres from your machine.
# Inside the Docker network the hostname is `postgres`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# Kafka - used by consumer/kafka_to_minio.py
# 29092 is the host-facing listener (9092 is internal to the Docker network).
# ---------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_GROUP=banking-consumer-group

# ---------------------------------------------------------------
# MinIO - MINIO_ROOT_* are read by docker-compose.yml,
# the rest by consumer/kafka_to_minio.py
# ---------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=banking-raw

# ---------------------------------------------------------------
# Airflow metadata database - used by docker-compose.yml
# ---------------------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
